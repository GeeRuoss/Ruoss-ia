---
import { SITE } from '../data/site';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={['contact-form', { 'contact-form--card': compact }]}>
  <form class="project-message" data-whatsapp={SITE.whatsapp} hidden>
    <p class="form-title">Parlons de votre projet.</p>
    <label>Votre prénom ou entreprise<input name="name" autocomplete="name" required maxlength="100" /></label>
    <label>Votre besoin<select name="service"><option>Du graphisme ou de la 3D</option><option>Un site ou une application web</option><option>Une formation ou une solution IA</option><option>Un autre projet</option></select></label>
    <label>Votre idée <span class="optional">(facultatif)</span><textarea name="idea" rows="3" maxlength="2000" placeholder="Votre activité, vos objectifs, votre échéance…"></textarea></label>
    <div class="message-preview"><p>Votre message</p><output class="message-text"></output></div>
    <button class="btn btn--dark" type="submit">Préparer dans WhatsApp <span aria-hidden="true">↗</span></button>
    <p class="form-note">Vous relisez et envoyez le message dans WhatsApp. Rien n’est envoyé pendant la saisie.</p>
  </form>
  <p class="contact-fallback"><a href={SITE.whatsapp} target="_blank" rel="noopener">Écrire sur WhatsApp</a><span aria-hidden="true"> · </span><a href={`mailto:${SITE.email}`}>Écrire par e-mail</a></p>
</div>
<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLFormElement>('.project-message').forEach((form) => {
      if (form.dataset.ready) return;
      form.dataset.ready = 'true';
      const output = form.querySelector<HTMLOutputElement>('output');
      const message = () => {
        const data = new FormData(form);
        const name = String(data.get('name') || '').trim();
        const idea = String(data.get('idea') || '').trim();
        const service = String(data.get('service') || 'votre accompagnement');
        const subject = service.charAt(0).toLowerCase() + service.slice(1);
        return `Bonjour Guillermo,${name ? ` je suis ${name}.` : ''}\nJe vous contacte pour ${subject}.${idea ? `\n\n${idea}` : ''}`;
      };
      const update = () => { if (output) output.value = message(); };
      form.addEventListener('input', update);
      form.addEventListener('change', update);
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        window.open(`${form.dataset.whatsapp}?text=${encodeURIComponent(message())}`, '_blank', 'noopener,noreferrer');
      });
      update();
      form.hidden = false;
    });
  });
</script>
<style>
  .contact-form--card { background: var(--white); color: var(--ink); border-radius: var(--r-card); padding: 24px; }
  form { display: grid; gap: 20px; }
  form[hidden] { display: none; }
  .form-title { font-size: 1.5rem; font-weight: 600; letter-spacing: -.03em; }
  label { display: grid; gap: 8px; font-size: 1rem; }
  input, textarea, select { width: 100%; min-width: 0; border: 1px solid #888; border-radius: 8px; background: white; color: #111; padding: 12px; font: inherit; font-size: 1rem; }
  textarea { resize: vertical; }
  .optional { color: #666; }
  .message-preview { background: #edf2ec; padding: 16px; border-radius: 12px; color: #16231a; }
  .message-preview > p { font-weight: 600; margin-bottom: 8px; }
  output { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 1rem; line-height: 1.5; }
  .form-note { font-size: 1rem; line-height: 1.5; color: #555; }
  .contact-fallback { margin-top: 20px; font-size: 1rem; line-height: 1.6; }
  .contact-fallback a { text-decoration: underline; text-underline-offset: 4px; display: inline-block; padding-block: 8px; }
</style>
