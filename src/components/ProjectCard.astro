---
// Carte projet : barre blanche (nom / année ⋯) + visuel assombri avec logo centré.
interface Props {
  name: string;
  year: string;
  logo: string;
  cover: string;
  logoWidth?: number;
  href?: string;
}
const { name, year, logo, cover, logoWidth = 200, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="pcard reveal" href={href}>
  <div class="pcard-bar">
    <p class="pcard-name">{name}</p>
    <p class="small muted">/{year}</p>
    <span class="pcard-dots" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
  </div>
  <div class="pcard-media">
    <img class="pcard-cover" src={cover} alt="" loading="lazy" />
    <img class="pcard-logo" src={logo} alt={name} style={`width:${logoWidth}px`} loading="lazy" />
  </div>
</Tag>

<style>
  .pcard {
    display: block;
  }
  .pcard-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--white);
    border-radius: var(--r-card) var(--r-card) 0 0;
    padding: 14px 18px;
  }
  .pcard-name {
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .pcard-dots {
    margin-left: auto;
    display: inline-flex;
    gap: 4px;
  }
  .pcard-dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gray);
  }
  .pcard-media {
    position: relative;
    border-radius: 0 0 var(--r-card) var(--r-card);
    overflow: clip;
    /* Carte live 682×561 dont barre ~50px → média 4:3 */
    aspect-ratio: 4 / 3;
  }
  .pcard-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .pcard-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(18, 18, 18, 0.45);
  }
  a.pcard:hover .pcard-cover {
    transform: scale(1.04);
  }
  .pcard-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    height: auto;
  }
</style>
