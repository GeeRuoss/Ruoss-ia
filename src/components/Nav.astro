---
import Logo from './Logo.astro';
import { NAV, SITE } from '../data/site';
---

<header class="nav page">
  <a href="/" class="nav-logo" aria-label="Accueil"><Logo width={38} /></a>
  <nav class="nav-links" aria-label="Navigation principale">
    {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu">
    <span></span>
    <span></span>
  </button>
</header>

<div class="menu" id="menu" hidden>
  <div class="menu-inner page">
    <nav class="menu-links" aria-label="Menu">
      <a href="/">Accueil</a>
      <a href="/studio">Studio</a>
      <a href="/projects-2">Projects</a>
      <a href="/services">Services</a>
      <a href="/contact">Contact</a>
    </nav>
    <div class="menu-bottom">
      <a class="menu-phone" href={SITE.phoneHref}>{SITE.phoneDisplay}</a>
      <p class="small muted">© 2026 Ruoss® Communication</p>
    </div>
  </div>
</div>

<style>
  .nav {
    display: flex;
    align-items: center;
    height: var(--nav-h);
    position: sticky;
    top: 0;
    z-index: 20;
    max-width: none;
    transition: background 0.35s ease, box-shadow 0.35s ease;
  }
  .nav.is-scrolled {
    background: rgba(245, 245, 245, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(10, 10, 10, 0.06);
  }
  .nav-logo {
    flex: none;
    color: var(--ink);
  }
  .nav-links {
    flex: 1;
    display: flex;
    justify-content: space-evenly;
    padding-inline: 8vw;
  }
  .nav-links a {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.02em;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }
  .nav-links a:hover {
    opacity: 0.55;
  }
  .burger {
    flex: none;
    display: grid;
    gap: 7px;
    padding: 10px 0;
  }
  .burger span {
    display: block;
    width: 44px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .burger.is-open span:first-child {
    transform: translateY(4.25px) rotate(45deg);
  }
  .burger.is-open span:last-child {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  /* Menu plein écran */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 15;
    background: var(--dark);
    color: var(--white);
    display: flex;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8vh;
  }
  .menu-links {
    display: grid;
    gap: 4px;
  }
  .menu-links a {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.1;
    opacity: 0.92;
    transition: opacity 0.2s ease, transform 0.3s ease;
  }
  .menu-links a:hover {
    opacity: 0.5;
    transform: translateX(8px);
  }
  .menu-bottom {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .menu-phone {
    font-size: 20px;
    font-weight: 500;
  }

  @media (max-width: 809px) {
    .nav-links {
      display: none;
    }
    .burger span {
      width: 36px;
    }
  }
</style>

<script>
  const initNav = () => {
    const burger = document.querySelector<HTMLButtonElement>('.burger');
    const menu = document.getElementById('menu');
    if (!burger || !menu) return;
    burger.addEventListener('click', () => {
      const open = menu.hidden;
      menu.hidden = !open;
      burger.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      document.body.style.overflow = open ? 'hidden' : '';
      burger.querySelectorAll('span').forEach((s) => (s.style.background = open ? '#fff' : ''));
    });
    // Fermer le menu quand on clique un lien.
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.hidden = true;
        burger.classList.remove('is-open');
        document.body.style.overflow = '';
      })
    );
  };
  document.addEventListener('astro:page-load', initNav);

  // Fond de nav au scroll (un seul listener global, survit aux navigations).
  const onScroll = () => document.querySelector('.nav')?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', onScroll);
</script>
