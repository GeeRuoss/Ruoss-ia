---
import Logo from './Logo.astro';
import { NAV, SITE } from '../data/site';
---

<header class="nav page">
  <a href="/" class="nav-logo" aria-label="Accueil"><Logo width={38} /></a>
  <nav class="nav-links" aria-label="Navigation principale">
    {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu">
    <span></span>
    <span></span>
  </button>
</header>

<div class="menu" id="menu" hidden>
  <div class="menu-inner page">
    <nav class="menu-links" aria-label="Menu">
      <a href="/">Accueil</a>
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="menu-bottom">
      <a class="menu-phone" href={SITE.phoneHref}>{SITE.phoneDisplay}</a>
      <p class="small muted">© 2026 Ruoss® Communication</p>
    </div>
  </div>
</div>

<style>
  .nav {
    display: flex;
    align-items: center;
    height: var(--nav-h);
    position: sticky;
    top: 0;
    z-index: 20;
    max-width: none;
    transition: background 0.35s ease, box-shadow 0.35s ease;
  }
  .nav.is-scrolled {
    background: rgba(245, 245, 245, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(10, 10, 10, 0.06);
  }
  .nav-logo {
    flex: none;
    color: var(--ink);
  }
  .nav-links {
    flex: 1;
    display: flex;
    justify-content: space-evenly;
    padding-inline: 2vw;
    gap: 16px;
  }
  .nav-links a {
    white-space: nowrap;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.02em;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }
  .nav-links a:hover {
    opacity: 0.55;
  }
  .burger {
    flex: none;
    display: grid;
    gap: 7px;
    padding: 10px 0;
    min-height: 44px; min-width: 44px; margin-left: auto;
  }
  .burger span {
    display: block;
    width: 44px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .burger.is-open span:first-child {
    transform: translateY(4.25px) rotate(45deg);
  }
  .burger.is-open span:last-child {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  :global(.menu-open) .nav { background: var(--dark); color: var(--white); }
  :global(.menu-open) .nav-logo { color: var(--white); }
  :global(.menu-open) .nav-links { visibility: hidden; }
  :global(.menu-open) .burger span { background: var(--white); }
  /* Menu plein écran */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 15;
    background: var(--dark);
    color: var(--white);
    display: flex;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3vh;
    padding-top: calc(var(--nav-h) + 20px); padding-bottom: 32px; overflow-y: auto;
  }
  .menu-links {
    display: grid;
    gap: 4px;
  }
  .menu-links a {
    font-size: clamp(26px, 4.5vw, 56px);
    min-height: 44px;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.1;
    opacity: 0.92;
    transition: opacity 0.2s ease, transform 0.3s ease;
  }
  .menu-links a:hover {
    opacity: 0.5;
    transform: translateX(8px);
  }
  .menu-bottom {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .menu-phone {
    font-size: 20px;
    font-weight: 500;
  }

  @media (max-width: 1100px) {
    .nav-links {
      display: none;
    }
    .burger span {
      width: 36px;
    }
  }
</style>

<script>
  const initNav = () => {
    const burger = document.querySelector<HTMLButtonElement>('.burger');
    const menu = document.getElementById('menu');
    if (!burger || !menu || burger.dataset.ready === 'true') return;
    burger.dataset.ready = 'true';
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      burger.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      document.body.style.overflow = open ? 'hidden' : '';
      document.body.classList.toggle('menu-open', open);
    };
    setOpen(false);
    burger.addEventListener('click', () => setOpen(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  };
  initNav();
  document.addEventListener('astro:page-load', initNav);

  document.addEventListener('keydown', (event) => {
    const menu = document.getElementById('menu');
    const burger = document.querySelector<HTMLButtonElement>('.burger');
    if (!menu || menu.hidden || !burger) return;
    if (event.key === 'Escape') { burger.click(); burger.focus(); }
    if (event.key === 'Tab') {
      const items = [burger, ...menu.querySelectorAll<HTMLAnchorElement>('a')];
      const first = items[0]; const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    }
  });
  // Fond de nav au scroll (un seul listener global, survit aux navigations).
  const onScroll = () => document.querySelector('.nav')?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  document.addEventListener('astro:page-load', onScroll);
</script>
