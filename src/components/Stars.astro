---
// Cinq étoiles orange (extraites du site live).
import starsRaw from '../../public/brand/wordmark-small.svg?raw';

interface Props {
  width?: number;
}
const { width = 88 } = Astro.props;
const svg = starsRaw.replace('<svg ', `<svg width="${width}" role="img" aria-label="5 étoiles sur 5" `);
---

<span class="stars" set:html={svg} />

<style>
  .stars {
    display: inline-flex;
    line-height: 0;
  }
</style>
