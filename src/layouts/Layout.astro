---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, IMG, SERVICES } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string; // chemin canonique, ex. '/studio'
  ogImage?: string;
  noindex?: boolean;
  showFooter?: boolean;
  clientRouter?: boolean;
  structuredData?: Record<string, unknown>[];
}
const { title, description, path, ogImage = IMG.ogDefault, noindex = false, showFooter = true, clientRouter = true, structuredData = [] } = Astro.props;

const canonical = SITE.domain + (path === '/' ? '/' : path.replace(/\/$/, '') + '/');
const ogImageAbs = ogImage.startsWith('http') ? ogImage : SITE.domain + ogImage;

// Entité business partagée sur toutes les pages (@id stable).
const businessLd = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'LocalBusiness'],
  '@id': SITE.domain + '/#studio',
  name: 'Ruoss! Communication',
  description:
    'Studio de graphisme et agence web à Verbier, en Valais : identité visuelle, 3D, sites et applications sur mesure, formations et solutions IA.',
  url: SITE.domain,
  logo: SITE.domain + '/brand/logo-script-large.svg',
  telephone: '+41774506726',
  email: SITE.email,
  image: SITE.domain + IMG.ogDefault,
  founder: { '@type': 'Person', name: 'Guillermo Ruoss' },
  foundingDate: '2021',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Verbier',
    postalCode: '1936',
    addressRegion: 'Valais',
    addressCountry: 'CH',
  },
  areaServed: [{ '@type': 'Place', name: 'Verbier' }, { '@type': 'AdministrativeArea', name: 'Val de Bagnes' }, { '@type': 'AdministrativeArea', name: 'Valais' }],
  knowsLanguage: ['fr', 'en', 'es'],
  sameAs: [SITE.instagram, SITE.behance, SITE.maps],
  hasMap: SITE.maps,
  makesOffer: SERVICES.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title, url: SITE.domain + s.href } })),
};
const websiteLd = {
  '@context': 'https://schema.org', '@type': 'WebSite', '@id': SITE.domain + '/#website',
  url: SITE.domain + '/', name: SITE.name, alternateName: 'Ruoss Communication', inLanguage: 'fr-CH',
  publisher: { '@id': SITE.domain + '/#studio' },
};
const pageLd = {
  '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical + '#webpage',
  url: canonical, name: title, description, inLanguage: 'fr-CH',
  isPartOf: { '@id': SITE.domain + '/#website' }, about: { '@id': SITE.domain + '/#studio' },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/favicon-light.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/brand/favicon-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/brand/favicon-dark.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ruoss! Communication" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content="fr_CH" />
    <!-- X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <script type="application/ld+json" set:html={JSON.stringify(businessLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(pageLd)} />}
    <slot name="head" />
    {clientRouter && <ClientRouter />}
    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <noscript><style is:inline>.reveal{opacity:1;transform:none}.wipe{clip-path:none}</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Nav />
    <main id="contenu"><slot /></main>
    {showFooter && <Footer />}
    <script>
      // Réinitialisé à chaque navigation (ClientRouter).
      const init = () => {
        // Stagger : les enfants d'un [data-stagger] deviennent des .reveal décalés.
        document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
          [...group.children].forEach((el, i) => {
            el.classList.add('reveal');
            (el as HTMLElement).style.setProperty('--d', `${Math.min(i * 90, 540)}ms`);
          });
        });

        // Reveal au scroll (fade-up + balayage des titres), léger et sans lib.
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal, .wipe').forEach((el) => io.observe(el));

        // Compteurs animés (data-count, data-suffix).
        const cio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              cio.unobserve(e.target);
              const el = e.target as HTMLElement;
              const target = Number(el.dataset.count || '0');
              const suffix = el.dataset.suffix || '';
              const t0 = performance.now();
              const dur = 1800;
              const tick = (t: number) => {
                const p = Math.min(1, (t - t0) / dur);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(target * eased) + suffix;
                if (p < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            }
          },
          { threshold: 0.5 }
        );
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => cio.observe(el));
      };
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
