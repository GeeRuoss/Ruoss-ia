---
import Layout from '../../layouts/Layout.astro';
import { OFFERS } from '../../data/offers';
import { SITE, PROJECTS } from '../../data/site';
import ProjectCard from '../../components/ProjectCard.astro';
export function getStaticPaths() {
  return OFFERS.map((offer) => ({ params: { slug: offer.slug }, props: { offer } }));
}
const { offer } = Astro.props;
const path = `/services/${offer.slug}/`;
const projects = PROJECTS.filter((p) => offer.projects.includes(p.slug));
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'Service', '@id': SITE.domain + path + '#service', name: offer.label, description: offer.description, url: SITE.domain + path, provider: { '@id': SITE.domain + '/#studio' }, areaServed: [{ '@type': 'AdministrativeArea', name: 'Valais' }, { '@type': 'Place', name: 'Verbier' }] },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.domain + '/' }, { '@type': 'ListItem', position: 2, name: 'Services', item: SITE.domain + '/services/' }, { '@type': 'ListItem', position: 3, name: offer.label, item: SITE.domain + path }] },
];
---
<Layout title={offer.title} description={offer.description} path={path} structuredData={structuredData}>
  <article class="page offer">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/services/">Services</a><span aria-hidden="true">/</span><span aria-current="page">{offer.label}</span></nav>
    <header class="offer-hero">
      <div>
        <p class="offer-label">{offer.label} · Verbier &amp; Valais</p>
        <h1 class="display">{offer.heading}</h1>
        <p class="offer-intro">{offer.intro}</p>
        <a href="/contact/" class="btn btn--dark">{offer.cta}</a>
      </div>
      {offer.slug === 'solutions-ia-entreprise' ? <div class="ai-diagram" aria-label="Exemple de fonctionnement : vos informations, un assistant IA, votre validation">
        <p class="diagram-label">Un fonctionnement clair.</p>
        <div class="diagram-step"><span class="diagram-dot"></span><div><strong>Vos informations</strong><p>Les sources que vous choisissez.</p></div></div>
        <span class="diagram-arrow" aria-hidden="true">↓</span>
        <div class="diagram-step diagram-step--ai"><span class="diagram-dot"></span><div><strong>Votre assistant IA</strong><p>Une tâche. Un périmètre précis.</p></div></div>
        <span class="diagram-arrow" aria-hidden="true">↓</span>
        <div class="diagram-step"><span class="diagram-dot"></span><div><strong>Votre validation</strong><p>Vous gardez la décision.</p></div></div>
        <p class="diagram-note">Exemple de fonctionnement à adapter à votre entreprise.</p>
      </div> : <img class:list={['offer-image', { portrait: offer.slug === 'formation-ia-valais' }]} src={offer.image} alt={offer.alt} width="800" height="900" fetchpriority="high" />}

    </header>
    <section class="offer-section">
      <h2 class="display">{offer.sectionTitle}</h2>
      <div class="offer-grid">{offer.sections.map((s) => <div><h3>{s.title}</h3><p>{s.text}</p></div>)}</div>
    </section>
    <section class="offer-section offer-proof">
      <div><h2 class="display">{offer.proofTitle}</h2><p>{offer.proof}</p></div>
      {projects.length > 0 ? <div class="proof-grid">{projects.map((p) => <ProjectCard name={p.name} year={p.year} logo={p.logo} cover={p.cover} logoWidth={p.logoWidth} href={`/projects/${p.slug}/`} />)}</div> : <a class="text-link" href="/studio/">Rencontrer le studio <span aria-hidden="true">↗</span></a>}
    </section>
    <section class="offer-section">
      <h2 class="display">Comment on avance.</h2>
      <ol class="offer-grid process">{offer.process.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol>
    </section>
    <section class="offer-section faq">
      <h2 class="display">Vos questions.</h2>
      {offer.faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>
    <section class="offer-contact sheet">
      <h2 class="display">Une idée ?<br />Parlons-en.</h2>
      <div><p>Un échange avec Guillermo pour préciser votre projet et la prochaine étape.</p><a class="btn btn--light" href="/contact/">{offer.cta}</a><a class="text-link" href={SITE.phoneHref}>{SITE.phoneDisplay}</a></div>
    </section>
    <nav class="offer-related" aria-label="Autres services">{OFFERS.filter((o) => o.slug !== offer.slug).map((o) => <a href={`/services/${o.slug}/`}>{o.label} <span aria-hidden="true">↗</span></a>)}</nav>
  </article>
</Layout>
<style>
  .offer { max-width: 1400px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-block: 28px 48px; font-size: 1rem; }
  .breadcrumbs a { min-height: 44px; display: inline-flex; align-items: center; text-decoration: underline; text-underline-offset: 4px; }
  .offer-hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .offer-label { margin-bottom: 24px; color: #555; }
  h1 { font-size: clamp(2.75rem, 5.4vw, 5.8rem); line-height: 1.04; max-width: 15ch; }
  .offer-intro { font-size: 1.25rem; line-height: 1.6; margin-block: 28px; max-width: 56ch; }
  .offer-image { width: 100%; height: auto; aspect-ratio: 8/9; object-fit: cover; border-radius: 20px; }
  .portrait { object-position: center 30%; max-width: 360px; justify-self: center; }
  .ai-diagram { background: #121212; color: white; padding: clamp(24px,3vw,48px); border-radius: 20px; }
  .diagram-label { font-size: 1.75rem; font-weight: 500; margin-bottom: 36px; }
  .diagram-step { border: 1px solid #666; border-radius: 14px; padding: 24px; display: flex; gap: 16px; align-items: center; }
  .diagram-step strong { font-size: 1.35rem; font-weight: 500; }
  .diagram-step p, .diagram-note { font-size: 1rem; color: #ccc; }
  .diagram-step--ai { background: white; color: #121212; border-color: white; }
  .diagram-step--ai p { color: #555; }
  .diagram-dot { width: 10px; height: 10px; background: currentColor; border-radius: 50%; flex: none; }
  .diagram-arrow { display: block; text-align: center; font-size: 2rem; padding-block: 8px; }
  .diagram-note { margin-top: 28px; }
  .offer-section { padding-block: clamp(48px, 7vw, 96px); border-bottom: 1px solid var(--line); }
  h2 { font-size: clamp(2.25rem, 4vw, 4rem); line-height: 1.1; max-width: 23ch; margin-bottom: 36px; }
  h3 { font-size: 1.45rem; font-weight: 600; letter-spacing: -.03em; line-height: 1.25; margin-bottom: 16px; }
  .offer-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 40px; }
  p { font-size: 1.125rem; line-height: 1.65; }
  .offer-proof > div > p { max-width: 70ch; margin-bottom: 32px; }
  .proof-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 24px; }
  .process { padding-left: 1.4rem; }
  .process li { padding-left: 8px; }
  .faq { max-width: 960px; }
  details { border-top: 1px solid var(--line); padding-block: 20px; }
  summary { font-size: 1.25rem; font-weight: 500; cursor: pointer; min-height: 44px; padding-block: 10px; }
  details p { padding-block: 16px 8px; max-width: 70ch; }
  .offer-contact { margin-block: 64px 32px; padding: clamp(28px,5vw,72px); display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; }
  .offer-contact h2 { margin: 0; }
  .offer-contact p { margin-bottom: 24px; }
  .text-link { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; text-decoration: underline; text-underline-offset: 5px; }
  .offer-contact .text-link { display: flex; margin-top: 16px; }
  .offer-related { display: flex; flex-wrap: wrap; gap: 20px 40px; }
  .offer-related a { font-size: 1.125rem; min-height: 44px; display: inline-flex; align-items: center; gap: 16px; text-decoration: underline; text-underline-offset: 5px; }
  @media(max-width: 900px) { .offer-grid { grid-template-columns: 1fr; gap: 32px; } .offer-hero { grid-template-columns: 1fr; } .offer-image { aspect-ratio: 16/10; max-height: 500px; } .portrait { object-position: center 25%; } }
  @media(max-width: 600px) { .breadcrumbs { margin-bottom: 24px; } .proof-grid, .offer-contact { grid-template-columns: 1fr; } h1 { font-size: clamp(2.5rem,10vw,3.5rem); } }
</style>
