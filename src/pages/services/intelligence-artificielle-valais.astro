---
import Layout from '../../layouts/Layout.astro';
import AIHostingOptions from '../../components/AIHostingOptions.astro';
import AITrainingOffer from '../../components/AITrainingOffer.astro';
import { AI_TRAINING } from '../../data/ai';
import { SITE } from '../../data/site';
const path = '/services/intelligence-artificielle-valais/';
const structuredData = [
  { '@context':'https://schema.org', '@type':'Service', name:'Formations et solutions IA en Valais', url:SITE.domain+path, provider:{'@id':SITE.domain+'/#studio'}, areaServed:{'@type':'AdministrativeArea',name:'Valais'}, hasOfferCatalog:{'@type':'OfferCatalog', name:'Accompagnement IA', itemListElement:[{'@type':'Offer', price:AI_TRAINING.price, priceCurrency:AI_TRAINING.currency, description:AI_TRAINING.scope, url:SITE.domain+'/services/formation-ia-valais/', itemOffered:{'@type':'Service',name:'Formation IA en entreprise avec guide complet'}}]} },
  { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[{'@type':'ListItem',position:1,name:'Accueil',item:SITE.domain+'/'},{'@type':'ListItem',position:2,name:'Services',item:SITE.domain+'/services/'},{'@type':'ListItem',position:3,name:'Intelligence artificielle',item:SITE.domain+path}] },
];
---
<Layout title="IA en Valais : solutions locales, cloud & formations | Ruoss!" description="IA locale ou cloud, ChatGPT et Claude. Formation en entreprise en Valais : guide complet et demi-journée en présentiel pour 1 700 CHF." path={path} structuredData={structuredData} ogImage="/brand/og-ia-v1.jpg">
  <article class="page ai-page">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane"><a href="/services/">Services</a><span aria-hidden="true">/</span><span aria-current="page">Intelligence artificielle</span></nav>
    <header class="ai-intro"><p class="muted">Formations &amp; solutions IA · Verbier et Valais</p><h1 class="display">L’IA, au service<br />de votre métier.</h1><p class="intro-text">Des assistants pour travailler avec vos documents, des solutions adaptées à vos choix de confidentialité et des formations pour les prendre en main. Nous partons de votre travail pour construire un accompagnement utile à votre équipe.</p></header>
    <AIHostingOptions showDetails />
    <AITrainingOffer showDetails />
    <section class="ai-approach"><h2 class="display">Vos documents.<br />Des réponses utiles.</h2><div><p>Retrouver une procédure, chercher dans d’anciens dossiers ou préparer une réponse à un client : nous commençons par un cas concret. Un premier test sur les sources choisies permet de vérifier les réponses et leurs références avant d’étendre l’usage.</p><p>Votre équipe garde la main sur les accès, les validations et ce que l’agent est autorisé à faire. Le choix des outils, les coûts et la prise en main sont définis ensemble.</p><a class="text-link" href="/studio/">Rencontrer Guillermo</a></div></section>
    <section class="ai-contact sheet"><h2 class="display">On commence<br />par votre besoin.</h2><div><p>Décrivez-nous une tâche que vous aimeriez simplifier ou ce que votre équipe souhaite apprendre.</p><a class="btn btn--light" href="/contact/">Parlons de votre projet IA</a></div></section>
    <nav class="ai-related" aria-label="Autres domaines"><a href="/services/graphisme-branding-valais/">Graphisme &amp; 3D</a><a href="/services/creation-site-internet-valais/">Sites web &amp; développement</a></nav>
  </article>
</Layout>
<style>
  .ai-page { max-width:1400px; }
  .breadcrumbs { display:flex; flex-wrap:wrap; align-items:center; gap:12px; font-size:18px; margin-block:24px 40px; }
  .breadcrumbs a, .text-link, .ai-related a { display:inline-flex; align-items:center; min-height:48px; text-decoration:underline; text-underline-offset:5px; }
  h1 { font-size:clamp(44px,6vw,96px); line-height:1.04; margin-block:24px; }
  p { font-size:20px; line-height:1.65; }
  .intro-text { font-size:22px; max-width:62ch; }
  .ai-approach, .ai-contact { display:grid; grid-template-columns:1fr 1fr; gap:40px; padding-block:48px; }
  .ai-approach h2, .ai-contact h2 { font-size:clamp(36px,4vw,56px); line-height:1.1; }
  .ai-approach p + p { margin-top:20px; }
  .text-link { margin-top:20px; font-size:20px; }
  .ai-contact { padding:clamp(28px,5vw,64px); margin-block:32px; }
  .ai-contact p { margin-bottom:24px; }
  .ai-contact .btn { font-size:20px; text-align:center; }
  .ai-related { display:flex; flex-wrap:wrap; gap:16px 40px; font-size:20px; }
  @media(max-width:700px) { .ai-approach, .ai-contact { grid-template-columns:1fr; } }
</style>
