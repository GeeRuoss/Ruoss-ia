---
import Layout from '../layouts/Layout.astro';
import ServiceList from '../components/ServiceList.astro';
---

<Layout
  title="Graphisme, développement web & IA en Valais | Ruoss!"
  description="Trois domaines chez Ruoss! à Verbier : graphisme et 3D, sites et applications web sur mesure, formations et solutions IA pour les entreprises du Valais."
  path="/services"
>
  <section class="page">
    <h1 class="display services-h1 wipe">Du design.<br />Et des idées qui prennent vie.</h1>
    <ServiceList withMedia />
  </section>
</Layout>

<style>
  .services-h1 {
    font-size: clamp(40px, 6.5vw, 96px);
    padding-block: clamp(40px, 8vw, 120px);
    max-width: 19ch;
  }
</style>
