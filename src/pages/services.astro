---
import Layout from '../layouts/Layout.astro';
import ServiceList from '../components/ServiceList.astro';
---

<Layout
  title="Sites web, formation IA & graphisme en Valais | Ruoss!"
  description="Découvrez les services de Ruoss! à Verbier : sites internet, formations en intelligence artificielle, solutions IA et identité visuelle pour les entreprises du Valais."
  path="/services"
>
  <section class="page">
    <h1 class="display services-h1 wipe">Web, IA et design.</h1>
    <ServiceList withMedia />
  </section>
</Layout>

<style>
  .services-h1 {
    font-size: clamp(48px, 8.5vw, 120px);
    padding-block: clamp(40px, 8vw, 120px);
    max-width: 13ch;
  }
</style>
