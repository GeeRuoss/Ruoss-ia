---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import FounderCard from '../components/FounderCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ServiceList from '../components/ServiceList.astro';
import ContactCta from '../components/ContactCta.astro';
import Counters from '../components/Counters.astro';
import Stars from '../components/Stars.astro';
import logoLargeRaw from '../../public/brand/logo-script-large.svg?raw';
import { SITE, PROJECTS, OTHER_PROJECTS_CARD, CLIENT_LOGOS, REVIEWS } from '../data/site';
---

<Layout
  title="Agence web à Verbier, Valais | Sites internet & IA | Ruoss!"
  description="Ruoss! Communication à Verbier : création de sites internet en Valais, formations IA, solutions IA et identité visuelle. Parlons de votre projet."
  path="/"
>
  <!-- ============ HERO ============ -->
  <section class="hero-wrap">
    <div class="sheet hero">
      <div class="sheet-media" aria-hidden="true">
        <video src="/video/hero.mp4" autoplay muted loop playsinline></video>
      </div>
      <div class="hero-inner">
        <div class="hero-title-row">
          <div class="display hero-title" aria-label="Ruoss!">
            <span class="hero-word">Ruoss!</span>
            <span class="hero-mark" set:html={logoLargeRaw.replace('<svg ', '<svg width="140" ')} />
          </div>
        </div>
        <p class="hero-sub display">Communication</p>
        <ul class="hero-services">
          <li style="--i:0"><a href="/services/creation-site-internet-valais/">Sites internet</a></li>
          <li style="--i:1"><a href="/services/formation-ia-valais/">Formation IA</a></li>
          <li style="--i:2"><a href="/services/solutions-ia-entreprise/">Solutions IA</a></li>
          <li style="--i:3"><a href="/services/graphisme-branding-valais/">Graphisme &amp; branding</a></li>
        </ul>
        <div class="hero-crosses" aria-hidden="true"><span>+</span><span>+</span><span>+</span><span>+</span></div>
        <div class="hero-bottom">
          <div class="hero-position"><h1 class="hero-tagline">Votre agence web à Verbier, en Valais.</h1><p>Des sites dessinés à la main, pour vous.<br />Une IA qui vous aide vraiment.</p><a class="btn btn--light" href="/contact/">Parlons de votre projet</a></div>
          <p class="small hero-copy">© 2026 Ruoss! Communication</p>
          <div class="hero-founder"><FounderCard /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CLIENTS ============ -->
  <section class="section page clients">
    <div class="section-head rule">
      <p class="eyebrow">
        <svg class="dot-arrow" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="currentColor"/><path d="M5.5 10.5 10.5 5.5M7 5.5h3.5V9" stroke="var(--bg)" stroke-width="1.2" fill="none"/></svg>
        Ils nous font confiance
      </p>
      <p class="muted">(2021-26)</p>
    </div>
    <div class="marquee reveal" aria-label="Logos de nos clients">
      <ul>
        {CLIENT_LOGOS.map((logo) => (
          <li><img src={logo} alt="Logo client" loading="lazy" /></li>
        ))}
      </ul>
      <ul aria-hidden="true">
        {CLIENT_LOGOS.map((logo) => (
          <li><img src={logo} alt="" loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ PROJETS ============ -->
  <section class="section page projets">
    <div class="section-head rule">
      <p class="muted proj-count">(27)</p>
      <p class="proj-desc small">
        Nous avons accompagné des entreprises et indépendants de divers secteurs dans la réalisation de leurs objectifs.
        Voici quelques projets récents.
      </p>
    </div>
    <div class="proj-head">
      <h2 class="display h-giant wipe">Projets.<span class="proj-years">(2021-2026©)</span></h2>
    </div>
    <div class="proj-grid" data-stagger>
      {PROJECTS.map((p) => (
        <ProjectCard name={p.name} year={p.year} logo={p.logo} cover={p.cover} logoWidth={p.logoWidth} href={`/projects/${p.slug}/`} />
      ))}
      <ProjectCard
        name={OTHER_PROJECTS_CARD.name}
        year={OTHER_PROJECTS_CARD.year}
        logo={OTHER_PROJECTS_CARD.logo}
        cover={OTHER_PROJECTS_CARD.cover}
        logoWidth={OTHER_PROJECTS_CARD.logoWidth}
        href="/projects-2/"
      />
    </div>
  </section>

  <!-- ============ CHIFFRES + APPROCHE ============ -->
  <section class="section page chiffres rule">
    <Counters />
    <div class="approche">
      <div class="approche-mark reveal"><Logo width={54} /></div>
      <div class="approche-text reveal">
        <p class="lead">
          <span class="muted">Nous concevons chaque projet avec une vision artistique forte et essentielle.</span>
          Notre approche est simple : Nous privilégions la simplicité, la couleur, la beauté et l'innovation, au service
          d'un futur clair et fonctionnel.
        </p>
        <p class="approche-more small muted">
          Nous ne survendons pas et n'utilisons pas de discours marketing tape-à-l'œil. Nous concevons simplement des
          logos, des éléments visuels, des sites et des stratégies bien pensés, fonctionnels et durables, au service des
          entreprises et particuliers.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section page">
    <ServiceList />
  </section>

  <!-- ============ EXPÉRIENCES ============ -->
  <section class="section page avis">
    <div class="section-head rule">
      <p class="eyebrow">
        <svg class="dot-arrow" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="currentColor"/><path d="M5.5 10.5 10.5 5.5M7 5.5h3.5V9" stroke="var(--bg)" stroke-width="1.2" fill="none"/></svg>
        Testimonials
      </p>
      <p class="muted">(5/5)</p>
    </div>
    <h2 class="display h-giant avis-title wipe">Expériences.<span class="avis-years">©2021-2026</span></h2>
    <div class="avis-grid" data-stagger>
      <div class="avis-card avis-card--score reveal">
        <p class="avis-score display">5<span>/5</span></p>
        <p class="small">
          Plus de <strong>150 projets</strong> réalisés pour accompagner les entreprises et les indépendants dans leurs ambitions.
        </p>
        <div class="avis-mark"><Logo width={40} /></div>
        <a class="btn btn--dark" href={SITE.reviewLink} target="_blank" rel="noopener">Laisser un avis</a>
      </div>
      {REVIEWS.map((r) => (
        <div class="avis-card reveal">
          <div class="avis-user">
            <img src={r.avatar} alt={`${r.name} — ${r.company}`} width="46" height="46" loading="lazy" />
            <div>
              <p class="avis-name">{r.name}</p>
              <p class="small muted">{r.company}</p>
            </div>
          </div>
          <Stars width={80} />
          <p class="small avis-text">{r.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ INSTA ============ -->
  <section class="section page insta">
    <div class="section-head rule">
      <p class="eyebrow">
        <svg class="dot-arrow" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="currentColor"/><path d="M5.5 10.5 10.5 5.5M7 5.5h3.5V9" stroke="var(--bg)" stroke-width="1.2" fill="none"/></svg>
        Réseaux sociaux
      </p>
      <p class="muted">@ruoss_communication</p>
    </div>
    <h2 class="display h-giant wipe">
      <a href={SITE.instagram} target="_blank" rel="noopener" class="insta-link">Suivez-nous!</a>
    </h2>
    <p class="lead insta-sub reveal">Trouvez-nous uniquement sur insta.</p>
  </section>

  <ContactCta />
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero-wrap {
    /* Quasi pleine largeur, comme le live (6px de marge) */
    padding-inline: 6px;
  }
  .hero {
    min-height: calc(100svh - var(--nav-h) - 12px);
    display: flex;
  }
  /* Entrée du hero : vidéo qui se pose, titre balayé, le reste en cascade */
  .hero :global(.sheet-media video) {
    animation: media-settle 1.8s var(--ease-out) both;
  }
  .hero-word {
    display: inline-block;
    animation: wipe-in 1.1s var(--ease-out) 0.25s both;
  }
  .hero-mark {
    animation: fade-up 0.9s var(--ease-out) 0.9s both;
  }
  .hero-sub {
    animation: fade-up 0.9s var(--ease-out) 0.65s both;
  }
  .hero-services li {
    animation: fade-up 0.8s var(--ease-out) calc(0.9s + var(--i, 0) * 0.12s) both;
  }
  .hero-tagline {
    animation: fade-up 0.9s var(--ease-out) 1.1s both;
  }
  .hero-copy {
    animation: fade-up 0.9s var(--ease-out) 1.25s both;
  }
  .hero-founder {
    animation: fade-up 0.9s var(--ease-out) 1.35s both;
  }
  .hero-crosses {
    animation: fade-up 1s var(--ease-out) 1.5s both;
  }
  .hero-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 4vw, 56px);
    position: relative;
  }
  .hero-title-row {
    margin-top: clamp(24px, 6vh, 64px);
    display: flex;
    justify-content: center;
  }
  .hero-title {
    display: inline-flex;
    align-items: flex-start;
    gap: clamp(8px, 1.5vw, 24px);
    font-size: clamp(72px, 11.4vw, 200px);
  }
  .hero-mark :global(svg) {
    width: clamp(60px, 9.7vw, 168px);
    height: auto;
  }
  .hero-sub {
    text-align: center;
    font-size: clamp(18px, 1.45vw, 24px);
    letter-spacing: -0.06em;
    margin-top: -0.4em;
  }
  .hero-services {
    position: absolute;
    right: clamp(24px, 4vw, 56px);
    top: clamp(96px, 22vh, 220px);
    display: grid;
    gap: 10px;
  }
  .hero-services li {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  .hero-crosses {
    display: flex;
    justify-content: space-between;
    margin-top: auto;
    margin-bottom: clamp(32px, 8vh, 96px);
    opacity: 0.85;
    font-weight: 300;
    font-size: 18px;
  }
  .hero-bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 24px;
  }
  .hero-tagline {
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }
  .hero-copy {
    opacity: 0.75;
    padding-bottom: 8px;
  }
  .hero-founder {
    justify-self: end;
  }

  .hero-position { max-width: 36rem; }
  .hero-position > p { font-size: 1.125rem; margin-block: 1rem; line-height: 1.5; }
  .hero-services a { display: inline-flex; align-items: center; min-height: 44px; }
  .hero-bottom { grid-template-columns: minmax(0, 1.5fr) auto minmax(0, 1fr); }
  .hero-copy { display: none; }
  .hero-founder { grid-column: 3; }
  @media(max-width: 809px) { .hero-bottom { grid-template-columns: 1fr; } .hero-founder { grid-column: auto; } .hero-crosses { margin-block: 24px; } }

  @media(max-width: 809px) {
    .hero-title-row { order: 0; margin-top: 12px; }
    .hero-sub { order: 1; }
    .hero-bottom { order: 2; margin-top: 36px; }
    .hero-services { order: 3; grid-template-columns: 1fr 1fr; gap: 8px 20px; margin-top: 24px; }
    .hero-services li { font-size: 1rem; }
    .hero-crosses, .hero-founder { display: none; }
    .hero { min-height: auto; }
    .hero-inner { padding-block: 32px; }
  }
  /* ---------- Clients ---------- */
  .clients {
    padding-bottom: 0;
  }
  .clients .section-head {
    margin-bottom: 28px;
  }
  .marquee li {
    flex: none;
    width: clamp(160px, 15.5vw, 224px);
    background: var(--white);
    border-radius: 10px;
    overflow: clip;
  }
  .marquee img {
    width: 100%;
    height: auto;
  }

  /* ---------- Projets ---------- */
  .projets .section-head {
    align-items: start;
    margin-bottom: clamp(32px, 5vw, 72px);
  }
  .proj-head {
    text-align: center;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .proj-years {
    display: block;
    font-size: clamp(18px, 2vw, 30px);
    letter-spacing: -0.04em;
    margin-top: 8px;
  }
  .proj-desc {
    max-width: 260px;
    text-align: left;
  }
  .proj-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 2vw, 28px);
  }

  /* ---------- Chiffres ---------- */
  .approche {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(32px, 8vw, 140px);
    margin-top: clamp(56px, 8vw, 120px);
    align-items: start;
  }
  .approche-text .lead {
    max-width: 780px;
  }
  .approche-more {
    margin-top: 24px;
    max-width: 560px;
  }

  /* ---------- Avis ---------- */
  .avis-title {
    margin-block: 16px 40px;
  }
  .avis-years {
    display: block;
    font-size: clamp(16px, 1.8vw, 26px);
    letter-spacing: -0.04em;
    margin-top: 6px;
  }
  .avis-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    align-items: start;
  }
  .avis-card {
    background: var(--white);
    border-radius: var(--r-card);
    padding: 20px;
    display: grid;
    gap: 14px;
  }
  .avis-score {
    font-size: 64px;
  }
  .avis-score span {
    font-size: 24px;
    color: var(--gray);
  }
  .avis-mark {
    color: var(--ink);
  }
  .avis-user {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .avis-user img {
    border-radius: 50%;
    object-fit: cover;
  }
  .avis-name {
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .avis-text {
    white-space: pre-line;
  }

  /* ---------- Insta ---------- */
  .insta {
    text-align: left;
  }
  .insta h2 {
    margin-block: 16px 12px;
    text-align: center;
  }
  .insta-link {
    transition: opacity 0.25s ease;
  }
  .insta-link:hover {
    opacity: 0.6;
  }
  .insta-sub {
    text-align: center;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1023px) {
    .avis-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 809px) {
    .hero-services {
      position: static;
      margin-top: 32px;
    }
    .hero-bottom {
      grid-template-columns: 1fr;
    }
    .hero-founder {
      justify-self: start;
    }
    .proj-grid {
      grid-template-columns: 1fr;
    }
    .avis-grid {
      grid-template-columns: 1fr;
    }
    .approche {
      grid-template-columns: 1fr;
    }
  }
</style>
